{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/studio",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/films/virasat-2025",
      "destination": "/films/virasat-2026/",
      "permanent": true
    },
    {
      "source": "/films/janfest-2025",
      "destination": "/films/janfest-2026/",
      "permanent": true
    },
    {
      "source": "/films/mumbai-margazhi-2025",
      "destination": "/films/mumbai-margazhi-2026/",
      "permanent": true
    },
    {
      "source": "/films/the-wadalis",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/films/parmarth-ek-utsav",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/films/dakshinayan",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/films/tejpal-motors-conclave",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/films/isha-meet",
      "destination": "/weddings/",
      "permanent": true
    },
    {
      "source": "/films/samavay-khusrau-kabir-2026",
      "destination": "/films/khusrau-kabir-2026/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(img|logos|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
